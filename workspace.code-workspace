{
  "folders": [
    {
      "name": "🎨 Bluesky App (Frontend)",
      "path": "bluesky-app"
    },
    {
      "name": "🔧 ATProto PDS (Backend)",
      "path": "atproto/packages/pds"
    },
    {
      "name": "📚 ATProto API (Client)",
      "path": "atproto/packages/api"
    },
    {
      "name": "📋 Community Stream Lexicon",
      "path": "community-stream-lexicon"
    },
    {
      "name": "🌐 Pinata Integration",
      "path": "pinata-integration"
    },
    {
      "name": "🐳 Official PDS (Docker)",
      "path": "official-pds"
    },
    {
      "name": "📁 Root",
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "typescript.tsdk": "atproto/node_modules/typescript/lib",
    "files.exclude": {
      "**/node_modules": true,
      "**/.git": true,
      "**/dist": true,
      "**/build": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/.git": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/build/**": true
    },
    "terminal.integrated.profiles.windows": {
      "Bluesky App": {
        "path": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": ["-c", "cd '${workspaceFolder}/bluesky-app' && exec bash --login -i"],
        "icon": "paintcan",
        "overrideName": true,
        "color": "terminal.ansiBlue"
      },
      "ATProto PDS": {
        "path": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": ["-c", "cd '${workspaceFolder}/atproto' && exec bash --login -i"],
        "icon": "gear",
        "overrideName": true,
        "color": "terminal.ansiGreen"
      },
      "Pinata Integration": {
        "path": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": ["-c", "cd '${workspaceFolder}/pinata-integration' && exec bash --login -i"],
        "icon": "globe",
        "overrideName": true,
        "color": "terminal.ansiYellow"
      },
      "Lexicon": {
        "path": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": ["-c", "cd '${workspaceFolder}/community-stream-lexicon' && exec bash --login -i"],
        "icon": "book",
        "overrideName": true,
        "color": "terminal.ansiMagenta"
      },
      "Official PDS": {
        "path": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": ["-c", "cd '${workspaceFolder}/official-pds' && exec bash --login -i"],
        "icon": "server",
        "overrideName": true,
        "color": "terminal.ansiWhite"
      },
      "Root": {
        "path": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": ["-c", "cd '${workspaceFolder}' && exec bash --login -i"],
        "icon": "folder",
        "overrideName": true,
        "color": "terminal.ansiCyan"
      }
    },
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.cwd": "${fileDirname}",
    "terminal.integrated.automationProfile.windows": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": ["--login", "-i"]
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🚀 Start All Services",
        "dependsOn": [
          "Start Bluesky App",
          "Start PDS",
          "Start Pinata"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Start Bluesky App",
        "type": "shell",
        "command": "corepack yarn web",
        "options": {
          "cwd": "${workspaceFolder}/bluesky-app"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "group": "services"
        }
      },
      {
        "label": "Start PDS",
        "type": "shell",
        "command": "corepack pnpm --filter @atproto/pds start",
        "options": {
          "cwd": "${workspaceFolder}/atproto"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "group": "services"
        }
      },
      {
        "label": "Start Pinata",
        "type": "shell",
        "command": "npm run dev",
        "options": {
          "cwd": "${workspaceFolder}/pinata-integration"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "group": "services"
        }
      },
      {
        "label": "Start Official PDS (Docker)",
        "type": "shell",
        "command": "docker compose up",
        "options": {
          "cwd": "${workspaceFolder}/official-pds"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "group": "services"
        }
      },
      {
        "label": "🚀 Start All Services (with Official PDS)",
        "dependsOn": [
          "Start Bluesky App",
          "Start Official PDS (Docker)",
          "Start Pinata"
        ],
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "bradlc.vscode-tailwindcss"
    ]
  }
}

