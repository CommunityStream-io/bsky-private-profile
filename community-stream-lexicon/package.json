{
  "name": "@community-stream/lexicon",
  "version": "0.1.0",
  "description": "Custom AT Protocol lexicons for CommunityStream private profiles",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "lex gen-server ./src ./lexicons/com/community/actor/privacySettings.json ./lexicons/com/community/graph/followRequest.json ./lexicons/com/community/graph/respondToFollowRequest.json --yes && tsc",
    "dev": "lex gen-server ./src ./lexicons/com/community/actor/privacySettings.json ./lexicons/com/community/graph/followRequest.json ./lexicons/com/community/graph/respondToFollowRequest.json --yes --watch"
  },
  "keywords": [
    "atproto",
    "lexicon",
    "bluesky",
    "private-profiles"
  ],
  "author": "CommunityStream",
  "license": "MIT",
  "dependencies": {
    "@atproto/api": "^0.12.0",
    "@atproto/lexicon": "^0.4.0",
    "@atproto/xrpc-server": "^0.5.0"
  },
  "devDependencies": {
    "@atproto/lex-cli": "^0.5.0",
    "@types/express": "^4.17.21",
    "typescript": "^5.3.3"
  }
}
