meta {
  name: Create Follow Request
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/xrpc/com.atproto.repo.createRecord
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "repo": "{{did}}",
    "collection": "app.bsky.graph.followRequest",
    "record": {
      "$type": "app.bsky.graph.followRequest",
      "subject": "{{targetDid}}",
      "status": "pending",
      "createdAt": "{{$isoTimestamp}}"
    }
  }
}

script:post-response {
  const response = res.getBody();
  if (response.uri) {
    bru.setVar("followRequestUri", response.uri);
    bru.setVar("followRequestCid", response.cid);
  }
}

docs {
  # Create Follow Request
  
  Creates a follow request record for a user with a private profile.
  
  ## Request Body
  - `repo` (string): Your DID ({{did}})
  - `collection` (string): "app.bsky.graph.followRequest"
  - `record` (object):
    - `$type`: "app.bsky.graph.followRequest"
    - `subject` (string): DID of the user to follow
    - `status` (string): "pending"
    - `createdAt` (string): ISO 8601 timestamp
  
  ## Response
  Returns the created record:
  - `uri`: AT URI of the follow request record
  - `cid`: Content ID of the record
  
  ## Behavior
  - Creates a record in your repository
  - Record has status "pending" initially
  - Target user can list incoming requests using backlinks
  - Target user can approve/deny by updating the record status
  
  ## Test Scenario
  Part of "Follow Request Flow":
  1. Alice has a private profile
  2. Bob authenticates
  3. Bob creates follow request record to Alice
  4. Verify request created with status "pending"
  5. Alice can query for incoming requests by subject (her DID)
  
  **Environment Variables Required:**
  - `{{did}}`: Your DID (set automatically on login)
  - `{{targetDid}}`: Set this to the DID of the private profile to follow
  
  **Note:** Follow request URI is automatically saved to `{{followRequestUri}}` for use in updates.
}
