meta {
  name: Set Privacy (Private)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/xrpc/com.community.actor.setPrivacySettings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "isPrivate": true
  }
}

script:post-response {
  const response = res.getBody();
  if (response.uri) {
    bru.setVar("privacySettingsUri", response.uri);
    bru.setVar("privacySettingsCid", response.cid);
  }
}

docs {
  # Set Privacy (Private)
  
  Sets the user's profile to private mode.
  
  ## Request Body
  - `isPrivate` (boolean): Set to true to make profile private
  
  ## Response
  Returns the created/updated privacy settings record:
  - `uri`: AT URI of the privacy settings record
  - `cid`: Content ID of the record
  
  ## Test Scenario
  Part of "Make Profile Private" workflow:
  1. User authenticates
  2. User sets privacy to private
  3. Verify settings updated
  4. Other users will need to send follow requests
  
  **Note:** Privacy settings URI is automatically saved to `{{privacySettingsUri}}` for use in other requests.
}
