meta {
  name: Resolve Handle
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/xrpc/com.atproto.identity.resolveHandle?handle=user2.test
  body: none
  auth: none
}

params:query {
  handle: user2.test
}

docs {
  # Resolve Handle
  
  Resolves a handle to a DID.
  
  ## Query Parameters
  - `handle` (string): The handle to resolve (e.g., "user2.test")
  
  ## Response
  Returns:
  - `did`: The DID associated with the handle
  
  This is useful for looking up users by their handle.
}

